# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: required for the Admin dashboard's
# database, auth, and image storage. From your Supabase project dashboard:
# Settings -> API -> Project URL / anon public key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_public_key_here"

# SUPABASE_SERVICE_ROLE_KEY: server-only (NEVER prefix with VITE_ — that would
# ship it to the browser). Used only by server.ts to create new admin/staff
# logins from Settings. Settings -> API -> service_role key (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# APP_URL: The URL where the application is hosted.
APP_URL="http://localhost:3000"

# PAYMONGO_SECRET_KEY: server-only (NEVER prefix with VITE_). Test-mode key
# from PayMongo Dashboard -> Developers -> API Keys -> Secret key (sk_test_...).
PAYMONGO_SECRET_KEY="your_paymongo_secret_key_here"

# PAYMONGO_WEBHOOK_SECRET: from Dashboard -> Developers -> Webhooks -> your
# endpoint -> Signing secret (whsk_...). For local testing, forward events
# with a tunnel tool (e.g. ngrok) to /api/paymongo-webhook and register that
# public URL as the webhook endpoint in the dashboard.
PAYMONGO_WEBHOOK_SECRET="your_paymongo_webhook_secret_here"

# RESEND_API_KEY: server-only (NEVER prefix with VITE_). Used to email the
# customer when their order ships. Sign up free at resend.com -> API Keys ->
# Create API Key (starts with re_...).
RESEND_API_KEY="your_resend_api_key_here"
